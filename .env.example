# Supabase Configuration
# Replace these with your actual Supabase project URL and anon key from the Supabase dashboard
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Asana Configuration (Backend sync layer only - DO NOT expose to Vite/Frontend)
# ASANA_PERSONAL_ACCESS_TOKEN=your-asana-pat

# There is deliberately no service role key here. Vite inlines every VITE_-prefixed variable
# into the JavaScript bundle, so a service role key set this way is published to every visitor
# -- and it bypasses RLS, reads every table and can sign in as any account. The admin calls
# that need it (invites) live in the admin-invite Edge Function, where Supabase provides
# SUPABASE_SERVICE_ROLE_KEY server-side. Nothing in the browser needs it.
#
# Optional, on the function rather than here:
#   supabase secrets set ALLOWED_REDIRECT_ORIGINS=https://your-app.vercel.app
#
# The maintenance scripts under scripts/ (invite, sync-asana, backfill-skill-embeddings) do
# need it, and read it WITHOUT the VITE_ prefix -- that prefix, not the key itself, is what
# publishes a secret. Supply it for the length of one command rather than leaving it in .env:
#   SUPABASE_SERVICE_ROLE_KEY=... npm run backfill-skill-embeddings
